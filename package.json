{
  "name": "crystals",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Crystals - A dwarf mining game",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "verify": "bun run test && bun run lint && bun run format:check && bun run typecheck"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobinSchuler/Crystals.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
